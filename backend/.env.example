# Copy to .env and adjust
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/furniture
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
# When true, the OTP is returned in the API response (no SMS provider needed for local dev)
DEV_MODE=true
# Set true once send_sms() in app/routers/auth.py uses a real SMS provider (enables OTP login with DEV_MODE=false)
SMS_ENABLED=false
CORS_ORIGINS=http://localhost:5173
# Serve the built frontend from this API (single-service deploys). Leave empty in development.
STATIC_DIR=
